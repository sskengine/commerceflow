<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.7</version>
    <relativePath/>
  </parent>
  <groupId>com.sskengine.commerceflow</groupId>
  <artifactId>commerceflow-services</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>CommerceFlow Services</name>
  <description>Controlled Java microservice testbed for Enterprise Cognitive Architecture</description>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
    <mybatis.version>3.5.19</mybatis.version>
  </properties>
  <modules>
    <module>commerceflow-contracts</module>
    <module>commerceflow-messaging</module>
    <module>identity-service</module>
    <module>catalog-service</module>
    <module>inventory-service</module>
    <module>order-service</module>
    <module>payment-service</module>
    <module>delivery-service</module>
    <module>notification-service</module>
    <module>reporting-service</module>
    <module>audit-service</module>
    <module>api-gateway</module>
    <module>provider-stubs</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.sskengine.commerceflow</groupId>
        <artifactId>commerceflow-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sskengine.commerceflow</groupId>
        <artifactId>commerceflow-messaging</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${mybatis-spring-boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis</artifactId>
        <version>${mybatis.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>

